# Backend origin used by the Vite dev proxy (/api/* -> BACKEND_BASE_URL/api/*)
BACKEND_BASE_URL=http://localhost:8000

# Base URL used by the browser
# Dev: keep relative so requests go through the Vite proxy (no CORS needed)
# Prod: set to the public API URL, e.g. https://api.example.com/api
VITE_API_URL=/api
